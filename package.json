{
  "name": "@apcamargo/dsh-marimo",
  "version": "0.1.0",
  "description": "Work with a coding agent in a live marimo notebook through DeepSeek Harness",
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./client": "./client.js",
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./package.json": "./package.json",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.png"
  },
  "files": [
    "client.js",
    "lib/index.js",
    "lib/commands.js",
    "lib/tools.js",
    "lib/marimo.js",
    "lib/prompts.js",
    "lib/skill-content.js",
    "lib/skill.md",
    "lib/config.js",
    "lib/state.js",
    "lib/title.js",
    "lib/projection.js",
    "lib/types/**/*.d.ts",
    "locale",
    "icon.png",
    "assets/*.svg",
    "cordis.patch.yml",
    "NOTICE",
    "package.json"
  ],
  "keywords": [
    "dsh-plugin",
    "deepseek-harness",
    "marimo",
    "notebook"
  ],
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/apcamargo/dsh-marimo.git"
  },
  "scripts": {
    "test": "node test/smoke.js && node test/integration.js && node test/e2e.js"
  },
  "dependencies": {
    "@deepseek-ai/schemastery": "~3.18.5",
    "zod": "^4.4.3"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "^4.1.0",
    "@deepseek-ai/dsh-agent": "^0.2.2-rc.5",
    "@deepseek-ai/dsh-commands": "^0.2.2-rc.5",
    "@deepseek-ai/dsh-llm": "^0.2.2-rc.5",
    "@deepseek-ai/dsh-skill": "^0.2.2-rc.5",
    "@deepseek-ai/dsh-storage-domain": "^0.2.2-rc.5",
    "@deepseek-ai/dsh-system-prompt": "^0.2.2-rc.5",
    "@deepseek-ai/dsh-tools": "^0.2.2-rc.5"
  },
  "devDependencies": {
    "@deepseek-ai/cordis": "4.1.0",
    "@deepseek-ai/dsh-agent": "0.2.2-rc.5",
    "@deepseek-ai/dsh-commands": "0.2.2-rc.5",
    "@deepseek-ai/dsh-llm": "0.2.2-rc.5",
    "@deepseek-ai/dsh-storage-domain": "0.2.2-rc.5",
    "@deepseek-ai/dsh-system-prompt": "0.2.2-rc.5",
    "@deepseek-ai/dsh-tools": "0.2.2-rc.5",
    "typescript": "^5.9.3"
  },
  "engines": {
    "node": ">=22",
    "dsh": ">=0.2.2-rc.5 <0.3.0-0"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "@deepseek-ai/dsh-client-ui-conversation"
      ]
    }
  }
}
